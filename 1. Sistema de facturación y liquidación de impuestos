Algoritmo ACT1
//FACTURACION Y LIQUIDACION DE IMPUESTOS
//PROGRAMA DE PUNTO DE VENTA QUE REGISTRE COMPRAS CONTINUAS DE PRODUCTOS
	
	Definir PRECIOPRODUCT Como Entero
	Definir CANTIDADCOMPRAD Como Entero
	
	Escribir "BIENVENIDO AL CENTRO COMERCIAL"
	
	REPETIR
		
		Escribir "DIJITE EL PRECIO UNITARIO DEL PRODUCTO"
		LEER PRECIOPRODUCT
		
		Escribir "DIJITE LA CANTIDAD COMPRADA"
		LEER CANTIDADCOMPRAD
		
		SUBTT = PRECIOPRODUCT * CANTIDADCOMPRAD
		ACOGLOBAL = ACOGLOBAL + SUBTT
		
			SI SUNTT > 100000 Entonces
				DESCUENTO = SUBTT * 10/100
					Escribir "DESCUENTO APLICADO"
				FinSi
				
			Hasta Que PRECIOPRODUCT = 0
			
			IVA = ACOGLOBAL * 19/100
			Escribir "EL IVA ES = ", IVA
			FINAL = ACOGLOBAL + IVA 
			Escribir "EL TOTAL ES = ", FINAL
	
FinAlgoritmo
